@article{chenStructuralBasisSeamless2020,
  title = {Structural Basis of Seamless Excision and Specific Targeting by {{piggyBac}} Transposase},
  author = {Chen, Qiujia and Luo, Wentian and Veach, Ruth Ann and Hickman, Alison B. and Wilson, Matthew H. and Dyda, Fred},
  year = 2020,
  month = jul,
  journal = {Nature Communications},
  volume = {11},
  number = {1},
  pages = {3446},
  issn = {2041-1723},
  doi = {10.1038/s41467-020-17128-1},
  url = {https://www.nature.com/articles/s41467-020-17128-1},
  urldate = {2026-08-07},
  abstract = {Abstract                            The               piggyBac               DNA transposon is used widely in genome engineering applications. Unlike other transposons, its excision site can be precisely repaired without leaving footprints and it integrates specifically at TTAA tetranucleotides. We present cryo-EM structures of               piggyBac               transpososomes: a synaptic complex with hairpin DNA intermediates and a strand~transfer complex capturing the integration step. The results show that the excised TTAA hairpin intermediate and the TTAA target adopt essentially identical conformations, providing a mechanistic link connecting the two unique properties of               piggyBac               . The transposase forms an asymmetric dimer in which the two central domains synapse the ends while two C-terminal domains form a separate dimer that contacts only one transposon end. In the strand~transfer structure, target DNA is severely bent and the TTAA target is unpaired. In-cell data suggest that asymmetry promotes synaptic complex formation, and modifying ends with additional transposase binding sites stimulates activity.},
  langid = {english},
  file = {/home/darah/Zotero/storage/EYJXTAN6/Chen et al. - 2020 - Structural basis of seamless excision and specific targeting by piggyBac transposase.pdf}
}

