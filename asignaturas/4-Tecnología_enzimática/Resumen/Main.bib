@article{garcia-mouronteUnderstandingActivePhotoprotection2024,
  title = {Understanding {{Active Photoprotection}}: {{DNA-Repair Enzymes}} and {{Antioxidants}}},
  shorttitle = {Understanding {{Active Photoprotection}}},
  author = {{Garcia-Mouronte}, Emilio and {P{\'e}rez-Gonz{\'a}lez}, Luis Alfonso and {Naharro-Rodriguez}, Jorge and Fern{\'a}ndez Guarino, Montserrat},
  year = 2024,
  month = jun,
  journal = {Life},
  volume = {14},
  number = {7},
  pages = {822},
  issn = {2075-1729},
  doi = {10.3390/life14070822},
  url = {https://www.mdpi.com/2075-1729/14/7/822},
  urldate = {2026-05-04},
  abstract = {The detrimental effects of ultraviolet radiation (UVR) on human skin are well-documented, encompassing DNA damage, oxidative stress, and an increased risk of carcinogenesis. Conventional photoprotective measures predominantly rely on filters, which scatter or absorb UV radiation, yet fail to address the cellular damage incurred post-exposure. To fill this gap, antioxidant molecules and DNA--repair enzymes have been extensively researched, offering a paradigm shift towards active photoprotection capable of both preventing and reversing UV--induced damage. In the current review, we focused on ``active photoprotection'', assessing the state-of-the-art, latest advancements and scientific data from clinical trials and in vivo models concerning the use of DNA-repair enzymes and naturally occurring antioxidant molecules.},
  langid = {english},
  keywords = {Fotoliasas},
  file = {/home/darah/Zotero/storage/KXZZZF3Q/Garcia-Mouronte et al. - 2024 - Understanding Active Photoprotection DNA-Repair Enzymes and Antioxidants.pdf}
}

@article{ramirez-gamboaPhotolyaseProductionCurrent2022,
  title = {Photolyase {{Production}} and {{Current Applications}}: {{A Review}}},
  shorttitle = {Photolyase {{Production}} and {{Current Applications}}},
  author = {{Ram{\'i}rez-Gamboa}, Diana and {D{\'i}az-Zamorano}, Ana Laura and {Mel{\'e}ndez-S{\'a}nchez}, Edgar Ricardo and {Reyes-Pardo}, Humberto and {Villase{\~n}or-Zepeda}, Karen Rocio and {L{\'o}pez-Arellanes}, Miguel E. and {Sosa-Hern{\'a}ndez}, Juan Eduardo and {Coronado-Apodaca}, Karina G. and {G{\'a}mez-M{\'e}ndez}, Ana and Afewerki, Samson and Iqbal, Hafiz M. N. and {Parra-Saldivar}, Roberto and {Mart{\'i}nez-Ruiz}, Manuel},
  year = 2022,
  month = sep,
  journal = {Molecules},
  volume = {27},
  number = {18},
  pages = {5998},
  issn = {1420-3049},
  doi = {10.3390/molecules27185998},
  url = {https://www.mdpi.com/1420-3049/27/18/5998},
  urldate = {2026-05-04},
  abstract = {The photolyase family consists of flavoproteins with enzyme activity able to repair ultraviolet light radiation damage by photoreactivation. DNA damage by the formation of a cyclobutane pyrimidine dimer (CPD) and a pyrimidine-pyrimidone (6-4) photoproduct can lead to multiple affections such as cellular apoptosis and mutagenesis that can evolve into skin cancer. The development of integrated applications to prevent the negative effects of prolonged sunlight exposure, usually during outdoor activities, is imperative. This study presents the functions, characteristics, and types of photolyases, their therapeutic and cosmetic applications, and additionally explores some photolyase-producing microorganisms and drug delivery systems.},
  langid = {english},
  keywords = {Fotoliasas},
  file = {/home/darah/Zotero/storage/4RG5QCE3/Ramírez-Gamboa et al. - 2022 - Photolyase Production and Current Applications A Review.pdf}
}

@article{bissoyiIceNucleationProperties2019,
  title = {Ice {{Nucleation Properties}} of {{Ice-binding Proteins}} from {{Snow Fleas}}},
  author = {Bissoyi, Akalabya and Reicher, Naama and Chasnitsky, Michael and Arad, Sivan and Koop, Thomas and Rudich, Yinon and Braslavsky, Ido},
  year = 2019,
  month = sep,
  journal = {Biomolecules},
  volume = {9},
  number = {10},
  pages = {532},
  issn = {2218-273X},
  doi = {10.3390/biom9100532},
  url = {https://www.mdpi.com/2218-273X/9/10/532},
  urldate = {2026-05-05},
  abstract = {Ice-binding proteins (IBPs) are found in many organisms, such as fish and hexapods, plants, and bacteria that need to cope with low temperatures. Ice nucleation and thermal hysteresis are two attributes of IBPs. While ice nucleation is promoted by large proteins, known as ice nucleating proteins, the smaller IBPs, referred to as antifreeze proteins (AFPs), inhibit the growth of ice crystals by up to several degrees below the melting point, resulting in a thermal hysteresis (TH) gap between melting and ice growth. Recently, we showed that the nucleation capacity of two types of IBPs corresponds to their size, in agreement with classical nucleation theory. Here, we expand this finding to additional IBPs that we isolated from snow fleas (the arthropod Collembola), collected in northern Israel. Chemical analyses using circular dichroism and Fourier-transform infrared spectroscopy data suggest that these IBPs have a similar structure to a previously reported snow flea antifreeze protein. Further experiments reveal that the ice-shell purified proteins have hyperactive antifreeze properties, as determined by nanoliter osmometry, and also exhibit low ice-nucleation activity in accordance with their size.},
  langid = {english},
  keywords = {Proteinas anticongelantes},
  file = {/home/darah/Zotero/storage/284DYC25/Bissoyi et al. - 2019 - Ice Nucleation Properties of Ice-binding Proteins from Snow Fleas.pdf}
}

