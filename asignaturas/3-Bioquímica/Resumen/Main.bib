@article{motaEvaluacionPropiedadesFisicoquimicas2026,
  title = {{Evaluaci\'on de las propiedades fisicoqu\'imicas de las formas cristalinas de lactosa: an\'alisis de isotermas de sorci\'on y determinaci\'on de diagramas de estado}},
  shorttitle = {{Evaluaci\'on de las propiedades fisicoqu\'imicas de las formas cristalinas de lactosa}},
  author = {Mota, Lara and Enrique, Edgar},
  year = 2026,
  month = mar,
  publisher = {Facultad de Ingenier\'ia, Universidad Aut\'onoma de San Luis Potos\'i},
  url = {https://repositorioinstitucional.uaslp.mx/xmlui/handle/i/9845},
  urldate = {2026-06-07},
  abstract = {La lactosa es un disac\'arido ampliamente empleado en las industrias alimentaria y farmac\'eutica debido a su disponibilidad, estabilidad y funcionalidad en formulaciones s\'olidas. En estado s\'olido puede presentarse en distintas formas cristalinas, principalmente {$\alpha$}-lactosa monohidratada y {$\beta$}-lactosa anhidra, las cuales difieren en su estructura molecular y en su comportamiento frente a la humedad ambiental. Estas diferencias influyen en propiedades relevantes como la higroscopicidad, la estabilidad f\'isica y el comportamiento durante el almacenamiento. En este contexto, el presente trabajo tuvo como objetivo evaluar las caracter\'isticas fisicoqu\'imicas de estas formas cristalinas mediante el an\'alisis de isotermas de sorci\'on y la construcci\'on de diagramas de estado, herramientas que permiten comprender la interacci\'on del material con el agua bajo distintas condiciones ambientales. Para lograrlo, se emplearon diversas t\'ecnicas de caracterizaci\'on estructural, t\'ermica y morfol\'ogica que permitieron identificar diferencias en la organizaci\'on cristalina y en la respuesta del material ante variaciones de humedad y temperatura. A partir del an\'alisis obtenido se estableci\'o la relaci\'on entre la estructura del s\'olido y su comportamiento en funci\'on de la actividad de agua, lo que permiti\'o identificar regiones de estabilidad y posibles cambios f\'isicos asociados a la absorci\'on de humedad. Los resultados generados contribuyen a ampliar el conocimiento sobre el comportamiento de este carbohidrato en sistemas s\'olidos y proporcionan informaci\'on \'util para mejorar su manejo, almacenamiento y aplicaci\'on en diferentes procesos industriales donde la estabilidad del ingrediente resulta un factor clave.},
  copyright = {Acceso Embargado},
  langid = {spanish},
  file = {/home/darah/Zotero/storage/V9FWAXGP/Mota y Enrique - 2026 - Evaluación de las propiedades fisicoquímicas de las formas cristalinas de lactosa análisis de isote.pdf}
}

@article{zeusselLiquidliquidPhaseSeparation2025,
  title = {Liquid-liquid Phase Separation of Spider Silk Proteins},
  author = {Zeu{\ss}el, Lisa and Bargel, Hendrik and Holland, Gregory P. and Scheibel, Thomas},
  year = 2025,
  month = aug,
  journal = {Polymer Journal},
  volume = {57},
  number = {8},
  pages = {831--843},
  issn = {0032-3896, 1349-0540},
  doi = {10.1038/s41428-025-01039-3},
  url = {https://www.nature.com/articles/s41428-025-01039-3},
  urldate = {2026-08-07},
  abstract = {Abstract             Liquid-liquid phase separation (LLPS) is a phenomenon relevant in the multicomponent settings of many biological processes, including compartmentation, pathological conditions such as Alzheimer's disease, and protein assembly. LLPS also plays a key role in spider silk fiber formation. Many spider silk fibers display properties such as elasticity in combination with high mechanical strength, which result in an outstanding toughness exceeding that of steel or Kevlar. A thorough understanding of the natural silk spinning process is thus vital for translation to artificial spinning techniques to achieve biomimetic fibers with properties superior to those of other fibrous materials. This focus review summarizes the milestones of research on spider silk assembly, starting from two initial theories, i.e., the liquid crystal theory and the micelle theory, followed by evidence for the importance of LLPS in this process. Ex vivo studies and experiments utilizing recombinant spider silk proteins have highlighted the importance of LLPS during spider silk assembly. Here, we provide a consolidated view of the previously separate theories as a concerted, transitional concept, and describe practical implications showcasing the importance of this unifying concept for technical silk spinning.},
  langid = {english},
  file = {/home/darah/Zotero/storage/NMNPFPJR/Zeußel et al. - 2025 - Liquid‒liquid phase separation of spider silk proteins.pdf}
}

@article{blamiresPhysicochemicalPropertyVariation2017,
  title = {Physicochemical {{Property Variation}} in {{Spider Silk}}: {{Ecology}}, {{Evolution}}, and {{Synthetic Production}}},
  shorttitle = {Physicochemical {{Property Variation}} in {{Spider Silk}}},
  author = {Blamires, Sean J. and Blackledge, Todd A. and Tso, I-Min},
  year = 2017,
  month = jan,
  journal = {Annual Review of Entomology},
  volume = {62},
  number = {1},
  pages = {443--460},
  issn = {0066-4170, 1545-4487},
  doi = {10.1146/annurev-ento-031616-035615},
  url = {https://www.annualreviews.org/doi/10.1146/annurev-ento-031616-035615},
  urldate = {2026-08-07},
  abstract = {The unique combination of great stiffness, strength, and extensibility makes spider major ampullate (MA) silk desirable for various biomimetic and synthetic applications. Intensive research on the genetics, biochemistry, and biomechanics of this material has facilitated a thorough understanding of its properties at various levels. Nevertheless, methods such as cloning, recombination, and electrospinning have not successfully produced materials with properties as impressive as those of spider silk. It is nevertheless becoming clear that silk properties are a consequence of whole-organism interactions with the environment in addition to genetic expression, gland biochemistry, and spinning processes. Here we assimilate the research done and assess the techniques used to determine distinct forms of spider silk chemical and physical property variability. We suggest that more research should focus on testing hypotheses that explain spider silk property variations in ecological and evolutionary contexts.},
  langid = {english},
  file = {/home/darah/Zotero/storage/M3EW9YIG/Blamires et al. - 2017 - Physicochemical Property Variation in Spider Silk Ecology, Evolution, and Synthetic Production.pdf}
}

