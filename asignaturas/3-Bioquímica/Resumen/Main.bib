@article{greenwoodAlkalisSkin2016,
  title = {Alkalis and {{Skin}}},
  author = {Greenwood, John E. and Tan, Jin Lin and Ming, Justin Choong Tzen and Abell, Andrew D.},
  year = 2016,
  month = mar,
  journal = {Journal of Burn Care \& Research},
  volume = {37},
