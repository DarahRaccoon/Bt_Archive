@article{wangProteinSecondaryStructure2022,
  title = {Protein Secondary Structure in Spider Silk Nanofibrils},
  author = {Wang, Qijue and McArdle, Patrick and Wang, Stephanie L. and Wilmington, Ryan L. and Xing, Zhen and Greenwood, Alexander and Cotten, Myriam L. and Qazilbash, M. Mumtaz and Schniepp, Hannes C.},
  year = 2022,
  month = jul,
  journal = {Nature Communications},
  volume = {13},
  number = {1},
  pages = {4329},
  issn = {2041-1723},
  doi = {10.1038/s41467-022-31883-3},
  url = {https://www.nature.com/articles/s41467-022-31883-3},
  urldate = {2026-08-07},
  abstract = {Abstract             Nanofibrils play a pivotal role in spider silk and are responsible for many of the impressive properties of this unique natural material. However, little is known about the internal structure of these protein fibrils. We carry out polarized Raman and polarized Fourier-transform infrared spectroscopies on native spider silk nanofibrils and determine the concentrations of six distinct protein secondary structures, including {$\beta$}-sheets, and two types of helical structures, for which we also determine orientation distributions. Our advancements in peak assignments are in full agreement with the published silk vibrational spectroscopy literature. We further corroborate our findings with X-ray diffraction and magic-angle spinning nuclear magnetic resonance experiments. Based on the latter and on polypeptide Raman spectra, we assess the role of key amino acids in different secondary structures. For the recluse spider we develop a highly detailed structural model, featuring seven levels of structural hierarchy. The approaches we develop are directly applicable to other proteinaceous materials.},
  langid = {english},
  file = {/home/darah/Zotero/storage/ZDUEJ3EA/Wang et al. - 2022 - Protein secondary structure in spider silk nanofibrils.pdf}
}
